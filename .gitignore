# Environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local configuration — settings, not constants (REQUIREMENTS.md §4.2).
# config.example.toml IS committed; the real one is machine-specific.
config.toml

# Generated state. The catalog is an index, not the truth (NFR-2), and the
# thumbnail cache is derived from content hashes — neither belongs in git.
state/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Test fixture photographs are generated by tests/make_fixtures.py on the first
# test run. They are synthetic, and never committed: this repository holds no
# photographs. Only the README describing them is tracked.
tests/fixtures/photos/*
!tests/fixtures/photos/README.md

# Private project documents: the requirements, the build plan and its session
# log, migration decisions, and the pre-publication history bundle. They are
# about one person's library, and live in their own local-only git repository.
private/
